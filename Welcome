            border-radius: 0;
            padding: 20px;
            border: 1px solid #e0e0e0;
            transition: all 0.3s;
        }
        
        .budget-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        
        .budget-price {
            font-size: 24px;
            font-weight: 700;
            color: #000;
            margin-bottom: 10px;
        }
        
        .budget-features {
            list-style: none;
            padding: 0;
            margin: 15px 0;
