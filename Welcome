                    const platform = this.getAttribute('data-platform') || 'google';
                    
                    const welcome = normalizeMessageText(welcomeTemplates[platform]?.[budget]);
                    if (!welcome) return;

                    currentWelcomeText = welcome;
                    welcomeTextElement.innerHTML = `
                        <button class="copy-btn" data-action="copy-welcome" title="Clique para copiar">Copiar Welcome</button>
                        ${generateClipboardHtml(welcome)}
                    `;
                    copyToClipboard(welcome, this);
                });
            });

            document.addEventListener('click', function(e) {
                if (e.target && e.target.matches('.copy-btn[data-action="copy-welcome"]') && currentWelcomeText) {
                    copyToClipboard(currentWelcomeText, e.target);
                }
            });

            // Atalhos de Teclado (Ctrl+C)
            document.addEventListener('keydown', function(event) {
                if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'c' && !event.shiftKey) {
                    const selection = window.getSelection();
                    if (selection.toString().length === 0 && currentWelcomeText) {
                        event.preventDefault();
                        const welcomeCopyButton = document.querySelector('[data-action="copy-welcome"]');
