    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Google Sans', Arial, sans-serif;
            font-size: 11px;
        }
        
        body {
            background-color: #ffffff;
            min-height: 100vh;
            padding: 20px;
            color: #000000;
            max-width: 1000px;
            margin: 0 auto;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .theme-toggle-btn {
            position: fixed;
            top: 15px;
            right: 15px;
            z-index: 999;
            border: 1px solid #000000;
            background: #ffffff;
            color: #000000;
            border-radius: 999px;
            padding: 8px 14px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .theme-toggle-btn:hover {
            background-color: #000000;
            color: #ffffff;
        }

        body.dark-mode {
            background-color: #121212;
            color: #e7e7e7;
        }

        body.dark-mode h1,
        body.dark-mode h2,
        body.dark-mode h3,
        body.dark-mode label {
            color: #f3f3f3;
        }

        body.dark-mode .tabs,
        body.dark-mode h1,
        body.dark-mode .footer,
        body.dark-mode .welcome-section h3 {
            border-color: #333333;
        }

        body.dark-mode .welcome-section,
        body.dark-mode .budget-card {
            background-color: #1b1b1b;
            border-color: #333333;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.35);
        }

        body.dark-mode .welcome-text {
            background-color: #242424;
            border-color: #3a3a3a;
            color: #ebebeb;
        }

        body.dark-mode .tab-btn,
        body.dark-mode .platform-btn {
            background-color: #2a2a2a;
            color: #d7d7d7;
            border-color: #3a3a3a;
        }

        body.dark-mode .tab-btn:hover,
        body.dark-mode .platform-btn:hover {
            background-color: #3a3a3a;
        }

        body.dark-mode .tab-btn.active,
        body.dark-mode .platform-btn.active {
            background-color: #ffffff;
            color: #000000;
            border-color: #ffffff;
        }

        body.dark-mode .budget-features li,
        body.dark-mode .shortcut-info,
        body.dark-mode .footer {
            color: #bdbdbd;
        }

        body.dark-mode .theme-toggle-btn {
            background-color: #1f1f1f;
            color: #ffffff;
            border-color: #ffffff;
        }

        body.dark-mode .theme-toggle-btn:hover {
            background-color: #ffffff;
            color: #121212;
        }
        
        .tabs-container {
            margin-bottom: 20px;
        }
        
        .tabs {
            display: flex;
            gap: 5px;
            margin-bottom: 0;
            border-bottom: 1px solid #e0e0e0;
            flex-wrap: wrap;
        }
        
        .tab-btn {
            padding: 12px 18px;
            background: #f1f1f1;
            border: none;
            border-radius: 0;
            cursor: pointer;
            font-size: 12px;
            font-weight: 500;
            color: #555;
            transition: all 0.3s;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }
        
        .tab-btn:hover {
            background: #e8e8e8;
        }
        
        .tab-btn.active {
            background: #000;
            color: white;
            font-weight: 600;
        }

        @media (max-width: 768px) {
            .tabs {
                overflow-x: auto;
                padding-bottom: 5px;
            }
            
            .tab-btn {
                padding: 10px 15px;
                font-size: 11px;
            }
        }
        
        h1 {
            color: #000000;
            text-align: center;
            margin-bottom: 12px;
            font-size: 24px;
            font-weight: 600;
            padding-bottom: 15px;
            border-bottom: 1px solid #e0e0e0;
        }
        
        h2 {
            color: #000000;
            margin-bottom: 15px;
            font-size: 18px;
            font-weight: 600;
        }
        
        h3 {
            color: #000000;
            margin-bottom: 10px;
            font-size: 16px;
            font-weight: 600;
        }

        .welcome-section {
            background-color: #ffffff;
            border-radius: 0;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
            padding: 30px;
            border: 1px solid #e0e0e0;
        }
        
        .prompt-btn {
            width: 100%;
            padding: 12px;
            background-color: #000000;
            color: #ffffff;
            border: none;
            border-radius: 0;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }
        
        .prompt-btn:hover {
            background-color: #333333;
            transform: translateY(-1px);
        }

        .welcome-text {
            background-color: #f8f8f8;
            border-radius: 0;
            padding: 30px;
            margin-top: 15px;
            border: 1px solid #e0e0e0;
            line-height: 1.28;
            white-space: pre-wrap;
            word-wrap: break-word;
            font-size: 10.5px;
            color: #000000;
            min-height: 550px;
            position: relative;
            font-family: 'Google Sans', Arial, sans-serif;
            text-align: left;
        }
        
        .copy-btn {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 8px 15px;
            background-color: #000000;
            color: #ffffff;
            border: none;
            border-radius: 0;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            z-index: 10;
        }
        
        .copy-btn:hover {
            background-color: #333333;
        }
        
        .copy-btn:active {
            transform: scale(0.98);
        }
        
        .copy-btn.copied {
            background-color: #4CAF50;
        }

        .platform-buttons {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }
        
        .platform-btn {
            padding: 10px 20px;
            background-color: #f0f0f0;
            border: 1px solid #ddd;
            border-radius: 0;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            flex: 1;
            text-align: center;
        }
        
        .platform-btn:hover {
            background-color: #e0e0e0;
        }
        
        .platform-btn.active {
            background-color: #000;
            color: white;
            border-color: #000;
        }
        
        .budget-grid {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 20px;
        }

        .welcome-row {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .welcome-row-title {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
            color: #444;
        }

        .welcome-row-track {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            overflow-y: hidden;
            scroll-behavior: smooth;
            padding-bottom: 6px;
        }

        .welcome-row-track::-webkit-scrollbar {
            height: 8px;
        }

        .welcome-row-track::-webkit-scrollbar-thumb {
            background: #c7c7c7;
            border-radius: 999px;
        }

        .welcome-row-track .budget-card {
            flex: 0 0 280px;
            min-width: 280px;
        }

